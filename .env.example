# Copy to .env and fill in a real token only on a machine that should read
# the private repository. The seeded demo does not read either variable.
# npm run demo and npm run seed unset them for that process.
#
# Used only by: npm run import:draft-day
# Needs read access to BoydVC/draft-day (contents and pull requests).

GITHUB_TOKEN=replace-with-a-github-token

# Optional alias. import:draft-day reads this only when GITHUB_TOKEN is unset.
GH_TOKEN=replace-with-a-github-token
