{
  "name": "review-desk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43123",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43123",
    "demo": "env -u GITHUB_TOKEN -u GH_TOKEN tsx src/cli.ts seed && env -u GITHUB_TOKEN -u GH_TOKEN next dev --hostname 0.0.0.0 --port 43123",
    "lint": "eslint",
    "test": "vitest run",
    "seed": "env -u GITHUB_TOKEN -u GH_TOKEN tsx src/cli.ts seed",
    "score": "tsx src/cli.ts score",
    "score:nightly": "tsx src/cli.ts score --nightly",
    "review": "tsx src/cli.ts review",
    "import:fixtures": "tsx src/cli.ts import-fixtures",
    "import:draft-day": "tsx src/cli.ts import-github BoydVC/draft-day --from 1 --to 15",
    "import:diffs": "tsx src/cli.ts import-diffs",
    "review:diffs": "tsx src/cli.ts review-diffs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
